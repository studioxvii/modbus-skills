    "expected_points": [{"schema": "modbus-map/v1", "points": [
      {"point_id": "pressure", "protocol_offset": 0, "datatype": "uint16", "scale": 0.1},
      {"point_id": "temperature", "protocol_offset": 2, "datatype": "int16", "scale": 0.1},
